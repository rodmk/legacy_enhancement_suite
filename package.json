{
  "name": "legacy-enhancement-suite",
  "private": true,
  "scripts": {
    "check": "npm run check:syntax && npm run lint && npm run format:check && npm test",
    "test": "node --test test/*.test.cjs",
    "check:syntax": "node --check legacy_enhancement_suite.user.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint legacy_enhancement_suite.user.js eslint.config.mjs 'test/*.test.cjs'",
    "format": "prettier --write legacy_enhancement_suite.user.js eslint.config.mjs package.json .prettierrc.json .github/workflows/checks.yml 'test/*.test.cjs'",
    "format:check": "prettier --check legacy_enhancement_suite.user.js eslint.config.mjs package.json .prettierrc.json .github/workflows/checks.yml 'test/*.test.cjs'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  }
}
